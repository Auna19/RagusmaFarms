# Ragusma Farms NG® – Environment Configuration

# Application URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Authentication Secret (Used for signing JWT session tokens)
JWT_SECRET=ragusma_farms_super_secret_jwt_key_2026_minna

# Supabase PostgreSQL Database Configuration
# Obtain these from your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Paystack Payment Gateway (Optional / Ready for Production)
# Obtain from Paystack Dashboard: Settings -> API Keys & Webhooks
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_sample_ragusma_paystack_key_here
PAYSTACK_SECRET_KEY=sk_test_sample_ragusma_secret_key_here

